{
  "name": "simple-git-app",
  "productName": "Simple Git",
  "version": "0.0.2",
  "description": "macOS Git management app for browsing history, diffs, and commit operations",
  "main": ".vite/build/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/NejcZdovc/simple-git.git"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "biome check src",
    "lint:fix": "biome check --fix src",
    "format": "biome format --write src",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "full-check": "npm run lint && npm run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-dmg": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "electron": "^40.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "electron-updater": "^6.8.3",
    "highlight.js": "^11.11.1",
    "simple-git": "^3.27.0",
    "tailwindcss": "^4.2.1"
  }
}
